# The sandbox: runs the agent's tools. No internet access (see docker-compose.yml).
FROM python:3.12-slim

RUN useradd --create-home --uid 1000 sandbox

WORKDIR /opt/sandbox

# Layer caching: install requirements before copying source code
COPY sandbox/requirements.txt /opt/sandbox/sandbox/requirements.txt
RUN pip install --no-cache-dir -r /opt/sandbox/sandbox/requirements.txt

# Copy common circuit tools and sandbox server
COPY common/ /opt/sandbox/common
COPY sandbox/ /opt/sandbox/sandbox

ENV PYTHONPATH=/opt/sandbox \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 1000
EXPOSE 8000

CMD ["python", "-m", "sandbox.server"]
